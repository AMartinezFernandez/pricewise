        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "c7390e04-6e47-4bee-ae63-1e8a7927ac46",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    console.log('Token guardado automáticamente: ' + jsonData.data.token.substring(0, 10) + '...');",
                  "    pm.expect(pm.collectionVariables.get('token')).to.not.be.empty;",
                  "} else {",
                  "    console.log('No se encontró token en la respuesta');",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "id": "7f1cfe7d-e21a-45b9-a96e-3a1098f8034b",
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
