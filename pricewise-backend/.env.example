# =========================================
# Variables de Entorno - PriceWise Backend
# =========================================
# Copia este archivo a .env y configura tus valores
# NUNCA subas el archivo .env a Git

# =========================================
# JWT - Autenticación
# =========================================
# Genera una clave segura con: openssl rand -base64 32
JWT_SECRET=tu_clave_secreta_aqui_minimo_32_caracteres

# =========================================
# Base de Datos PostgreSQL
# =========================================
DB_PASSWORD=tu_password_de_postgres

# =========================================
# Perfil de Spring
# =========================================
# Opciones: dev, prod
SPRING_PROFILES_ACTIVE=dev

# =========================================
# Keepa API (Monitoreo de Amazon)
# =========================================
# Opcional - Obtén tu API key en https://keepa.com/#!api
KEEPA_API_KEY=

# =========================================
# Docker (opcional)
# =========================================
# Si usas docker-compose, estas variables se usan automáticamente
# DB_PASSWORD ya definido arriba
